{
  "name": "@heimdall/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Heimdall desktop capture client (Windows) \u2014 Tauri 2 shell around bundled Intel PresentMon (\u00a721\u2013\u00a722).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. --filter @heimdall/ui build && tauri dev",
    "build": "pnpm --dir ../.. --filter @heimdall/ui build && tauri build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vendor": "node scripts/fetch-fonts.mjs && node scripts/fetch-presentmon.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "fetch:presentmon": "node scripts/fetch-presentmon.mjs",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@heimdall/ingest-client": "workspace:*",
    "@heimdall/parsers": "workspace:*",
    "@heimdall/shared": "workspace:*",
    "@heimdall/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-store": "2.4.3",
    "@tauri-apps/plugin-updater": "2.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.4.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.1.0",
    "vitest": "4.1.7"
  }
}
