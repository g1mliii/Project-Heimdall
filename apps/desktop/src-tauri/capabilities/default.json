{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Development capability set for the capture window. Localhost is required only for the local Next.js hub; release CI replaces this file from release-capability.json before bundling.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/*" },
        { "url": "https://heimdall.dev/*" }
      ]
    }
  ]
}
