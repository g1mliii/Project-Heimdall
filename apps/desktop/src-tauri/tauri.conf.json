{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimdall Capture",
  "version": "0.1.0",
  "identifier": "dev.heimdall.capture",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heimdall Capture",
        "label": "main",
        "width": 412,
        "height": 680,
        "minWidth": 412,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "LICENSES.md": "LICENSES.md"
    },
    "externalBin": ["binaries/presentmon"],
    "shortDescription": "Frame-time capture for Heimdall",
    "longDescription": "Press a hotkey in-game to capture frame-time data with bundled Intel PresentMon, then upload a shareable, signed run report to the Heimdall hub.",
    "licenseFile": "LICENSES.md",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
